# Copy to .env (gitignored) and fill in your values.
# Create token at: https://huggingface.co/settings/tokens
#
#   cp .env.example .env
#
# huggingface_hub accepts either variable; metal scripts export both.
HF_TOKEN=

# Chat / completions server (:8000)
VLLM_MODEL=mlx-community/Qwen2.5-0.5B-Instruct-4bit

# Embedding server (:8001, --runner pooling)
VLLM_EMBEDDING_MODEL=mlx-community/Qwen3-Embedding-0.6B-8bit
VLLM_EMBEDDING_PORT=8001

# Metal dev: cap context + per-process GPU budget when ./scripts/dev.sh metal runs chat + embed
# VLLM_MAX_MODEL_LEN=8192
# VLLM_METAL_DUAL_MEMORY_FRACTION=0.40

# Load simulator: fraction of completion/chat requests with stream=true (TTFT dashboards)
# SIM_STREAM_FRACTION=0.33
